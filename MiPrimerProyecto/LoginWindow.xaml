<Window x:Class="MiPrimerProyecto.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GAMESTATION - Iniciar sesión"
        Height="550"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101A35">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#101A35" Offset="0"/>
                <GradientStop Color="#25134F" Offset="0.6"/>
                <GradientStop Color="#064E7A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="390"
                Padding="30"
                Background="#111C3D"
                BorderBrush="#7C3AED"
                BorderThickness="1.5"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="🎮"
                           FontSize="42"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock Text="GAMESTATION"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="INICIA SESIÓN EN TU CUENTA"
                           Foreground="#A78BFA"
                           FontSize="11"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                <TextBlock Text="Usuario"
                           Foreground="White"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="txtUsuario"
                         Height="36"
                         FontSize="14"
                         Padding="8"
                         Background="#1E2A50"
                         Foreground="White"
                         BorderBrush="#4DA9FF"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Contraseña"
                           Foreground="White"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="txtContrasena"
                             Height="36"
                             FontSize="14"
                             Padding="8"
                             Background="#1E2A50"
                             Foreground="White"
                             BorderBrush="#4DA9FF"
                             Margin="0,0,0,20"/>

                <Button x:Name="btnLogin"
                        Content="INICIAR SESIÓN"
                        Height="40"
                        Background="#7C3AED"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#A78BFA"
                        Cursor="Hand"
                        Click="BtnLogin_Click"
                        Margin="0,0,0,10"/>

                <Button x:Name="btnSalir"
                        Content="SALIR"
                        Height="36"
                        Background="#263B73"
                        Foreground="White"
                        BorderBrush="#4DA9FF"
                        Cursor="Hand"
                        Click="BtnSalir_Click"/>

                <!-- CONTENEDOR DEL MENSAJE -->
                <Border Background="#263B73"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,15,0,0"
                        MinHeight="40">

                    <TextBlock x:Name="txtMensaje"
                               Text=""
                               Foreground="#FCA5A5"
                               FontSize="13"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>
