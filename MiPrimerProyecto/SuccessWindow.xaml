<Window x:Class="MiPrimerProyecto.SuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GAMESTATION - Acceso correcto"
        Height="400"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101A35">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#101A35" Offset="0"/>
                <GradientStop Color="#25134F" Offset="0.6"/>
                <GradientStop Color="#064E7A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="420"
                Padding="30"
                Background="#111C3D"
                BorderBrush="#7C3AED"
                BorderThickness="1.5"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="🎮"
                           FontSize="45"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="¡Bienvenido a GAMESTATION!"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,15,0,8"/>

                <TextBlock x:Name="txtBienvenida"
                           Foreground="#A78BFA"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,25"/>

                <Button Content="CERRAR SESIÓN"
                        Height="42"
                        Background="#7C3AED"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#A78BFA"
                        Cursor="Hand"
                        Click="BtnCerrarSesion_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
